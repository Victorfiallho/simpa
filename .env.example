# Copie para .env e troque as senhas. O .env NUNCA vai para o Git (RNF04).
# Use senhas só com letras e números: elas entram em URLs de conexão, onde @ : / quebram.

# PostgreSQL (um banco por serviço, criados automaticamente)
POSTGRES_USER=simpa
POSTGRES_PASSWORD=troqueEstaSenha123

# RabbitMQ (painel em http://localhost:15672 com este usuário e senha)
RABBITMQ_USER=simpa
RABBITMQ_PASSWORD=troqueEstaSenha456

# Tempo de validade do token emitido pelo auth
JWT_EXPIRA_MINUTOS=60

# Porta do gateway no seu computador. Troque se a 80 já estiver em uso.
GATEWAY_PORTA=80
