# Ambiente de TESTE (compose.test.yml). Copie para .env.test, que não vai para o Git.
# Tudo aqui é sintético e descartável: não reutilize senhas de desenvolvimento nem de produção.
# Use só letras e números nas senhas (elas entram em URLs de conexão).

POSTGRES_USER=simpa_teste
POSTGRES_PASSWORD=senhaTestePostgres001

RABBITMQ_USER=simpa_teste
RABBITMQ_PASSWORD=senhaTesteRabbit002

JWT_EXPIRA_MINUTOS=60

# Senha dos usuários de teste criados pelo auth neste ambiente.
DEMO_SENHA=senhaTesteUsuarios003

# Senha do Grafana do monitoramento (compose.monitoramento.yml), sintética.
GRAFANA_SENHA=senhaTesteGrafana004
